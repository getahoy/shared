{
  "name": "@getahoy/shared-workspace",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome ci --error-on-warnings .",
    "test": "vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
